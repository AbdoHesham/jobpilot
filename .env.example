# ─── Flutter app (passed with --dart-define, never committed) ────────────────
# Public values; every table is protected by RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key from Supabase dashboard → Settings → API>

# ─── Edge Function secrets (supabase secrets set --env-file .env) ────────────
# Never ship these to the client.
ANTHROPIC_API_KEY=sk-ant-...          # parse-cv
RAPIDAPI_KEY=...                      # JSearch via RapidAPI (fetch-jobs, phase 2)
GITHUB_TOKEN=github_pat_...           # Fine-grained token with Issues: write
GITHUB_REPOSITORY=AbdoHesham/jobpilot # Optional; defaults to this repository

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically — do not set them with `secrets set`.
